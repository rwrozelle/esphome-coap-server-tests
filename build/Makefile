	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_oscore_keys.dir/build.make CMakeFiles/test_oscore_keys.dir/tests/test_oscore_keys.cpp.o
.PHONY : tests/test_oscore_keys.cpp.o

tests/test_oscore_keys.i: tests/test_oscore_keys.cpp.i
.PHONY : tests/test_oscore_keys.i

# target to preprocess a source file
tests/test_oscore_keys.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_oscore_keys.dir/build.make CMakeFiles/test_oscore_keys.dir/tests/test_oscore_keys.cpp.i
.PHONY : tests/test_oscore_keys.cpp.i

tests/test_oscore_keys.s: tests/test_oscore_keys.cpp.s
.PHONY : tests/test_oscore_keys.s

# target to generate assembly for a file
tests/test_oscore_keys.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_oscore_keys.dir/build.make CMakeFiles/test_oscore_keys.dir/tests/test_oscore_keys.cpp.s
.PHONY : tests/test_oscore_keys.cpp.s

